# AgentTrade environment. Copy to .env and fill in real keys on the host.
# Do not commit .env. config.example.json is the longer template.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# At least one research/analysis provider. Paper tier list is
# groq_qwen,gemini_flash,mistral_small unless you override it.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

LLM_MODE=tiered
DAILY_TOKEN_BUDGET=200000
LLM_TIERED_RESEARCH_MODELS=groq_qwen,gemini_flash,mistral_small
LLM_TIERED_ANALYSIS_MODELS=gemini_flash,groq_llama,mistral_small
LLM_TIERED_FANOUT=3
LLM_RATE_LIMIT_COOLDOWN_MINUTES=120

# Optional cheap failover. Leave the key blank to disable.
# A real key is appended after the explicit tier list (LLM_TIERED_AUTO_FAILOVER=1).
# NVIDIA_BASE_URL is the API root; the client appends /chat/completions.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
NVIDIA_API_KEY=
NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLAMA_MODEL=meta/llama-3.1-70b-instruct
LLM_TIERED_AUTO_FAILOVER=1
