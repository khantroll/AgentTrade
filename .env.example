# AgentTrade environment. Copy to .env and fill in real keys on the host.
# Do not commit .env. config.example.json is the longer template.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# At least one research/analysis provider. Paper tier list is
# groq_qwen,gemini_flash,mistral_small unless you override it.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

LLM_MODE=tiered
DAILY_TOKEN_BUDGET=200000
LLM_TIERED_RESEARCH_MODELS=groq_qwen,gemini_flash,mistral_small
LLM_TIERED_ANALYSIS_MODELS=gemini_flash,groq_llama,mistral_small
LLM_TIERED_FANOUT=3
# Unspecified HTTP 429 (no short Retry-After), such as a Mistral rate limit.
LLM_RATE_LIMIT_COOLDOWN_MINUTES=120
# Brief TPM / "try again in 5s" uses the provider wait, capped here. Not 7200.
LLM_SHORT_RATE_LIMIT_CAP_SECONDS=900
# HTTP 429 that mentions quota or billing (Gemini plan/quota). Not 24h.
LLM_QUOTA_COOLDOWN_MINUTES=60
# HTTP 402 / insufficient balance / billing disabled, with no 429. Not 24h.
LLM_BILLING_COOLDOWN_HOURS=6

# Optional cheap failover. Leave the key blank to disable.
# A real key is appended after the explicit tier list (LLM_TIERED_AUTO_FAILOVER=1).
# NVIDIA_BASE_URL is the API root; the client appends /chat/completions.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
NVIDIA_API_KEY=
NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Hosted NIM retired meta/llama-3.1-70b-instruct (HTTP 410 since 2026-08-26).
# A saved copy of that id is rewritten to this default at startup.
NVIDIA_LLAMA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Nemotron-family model ids reason by default on any host. JSON calls send
# chat_template_kwargs.enable_thinking=false and raise the completion cap so
# the reasoning trace cannot consume the reply. Set to 1 to leave thinking on.
LLM_ENABLE_THINKING=0
LLM_REASONING_JSON_MAX_TOKENS=1024
LLM_TIERED_AUTO_FAILOVER=1
